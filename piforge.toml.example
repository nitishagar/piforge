# piforge.toml.example — copy to piforge.toml and edit.
# All fields have defaults; this documents the common knobs.

[model]
# Path to the GGUF file. Only needed if piforge launches its own server (not yet
# implemented); for now start llama-server yourself and set server.base_url.
path = ""
quant = "Q4_K_M"
# Context window. On Pi 5 8GB with Q4 weights + Q8 KV, 8192 is realistic.
context = 8192
# "off" uses Qwen3-4B-Instruct-2507 (interactive, ~5 tok/s on Pi 5).
# "on" requires Qwen3-4B-Thinking-2507 — but it's a BATCH tool (~1.5 tok/s),
# not usable in an interactive loop. Leave off.
thinking_mode = "off"

[server]
base_url = "http://127.0.0.1:8080/v1"
api_key = "dummy"
max_tokens = 1024
temperature = 0.2

# --- Cloud providers (optional) ---------------------------------------------
# piforge is OpenAI-compatible, so any API-key provider works. Easiest: set a
# `provider` name and export PIFORGE_API_KEY — the endpoint + model are filled
# from a built-in registry (see docs/cloud-providers.md). Leave `api_key` as
# "dummy" here; a real key must NOT be written to this file (it would leak).
#
# PRIVACY: pointing piforge at a cloud provider sends the symptom, the setup
# file contents, and tool results (sensor reads, dmesg, board strings) OFF the
# device to the provider. Only use a provider you trust with that data.
#
# Choose ONE provider (then `export PIFORGE_API_KEY=<your-key>`):
#
# # provider = "zai-coding"   # z.ai GLM Coding Plan subscription (/api/coding/paas/v4)
# # provider = "zai"          # z.ai pay-as-you-go API balance (/api/paas/v4)
# # provider = "openai"       # OpenAI
# # provider = "kimi"         # Moonshot Kimi
# # provider = "openrouter"   # gateway → Claude / Gemini
#
# Prefer the explicit path? Leave `provider` unset and set base_url + model:
# # base_url = "https://your-endpoint/v1"
# # model    = "glm-4.6"      # explicit base_url/model always override the preset
# --- end cloud presets -------------------------------------------------------

[agent]
max_turns = 12
# Pre-populate the first turn with a telemetry snapshot to cut round-trips.
telemetry_preload = true

[hardware]
# Pi 5 40-pin header. Leave empty to auto-discover (gpiochip4, following a
# compat symlink to gpiochip0 on current Pi OS).
gpiochip = ""
i2c_bus = "/dev/i2c-1"

[safety]
# "confirm" = per-Class-I human confirm (default, safe).
# "auto" = auto-approve all (DANGEROUS; eval/batch only; requires PIFORGE_ALLOW_AUTO_ARM=1).
arm_mode = "confirm"
stop_on_under_voltage = true

[eval]
cases_dir = "eval/cases"
pass_rate_threshold = 0.55
hallucination_threshold = 0.10
